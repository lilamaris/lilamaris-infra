:80 {
  root * /srv

  encode zstd gzip

  @astro_assets path /_astro/*
  header @astro_assets Cache-Control "public, max-age=31536000, immutable"

  @html path *.html /
  header @html Cache-Control "public, max-age=60, s-maxage=300, stale-while-revalidate=60"

  log {
    output file /var/log/caddy/access.log
    format json
  }

  file_server
}
